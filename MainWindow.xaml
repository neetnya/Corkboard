<Window x:Class="Corkboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Corkboard.Controls"
        Title="截图线索板" Height="820" Width="1240"
        MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <DockPanel>
        <!-- 顶栏：分组 / 白板 / 设置 -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="GroupCombo" Width="160" Height="28" VerticalContentAlignment="Center" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="GroupCombo_SelectionChanged"/>
                <Button Content="新建分组" Margin="8,0,0,0" Click="NewGroup_Click"/>
                <Button Content="重命名" Margin="6,0,0,0" Click="RenameGroup_Click"/>
                <Button Content="删除分组" Style="{StaticResource DangerButton}" Margin="6,0,0,0" Click="DeleteGroup_Click"/>
                <Rectangle Width="1" Fill="#DDD" Margin="14,4" />
                <Button Content="添加便条" Click="AddNote_Click"/>
                <Button Content="清空白板" Style="{StaticResource DangerButton}" Margin="6,0,0,0" Click="ClearBoard_Click"/>
                <Rectangle Width="1" Fill="#DDD" Margin="14,4" />
                <Button Content="设置" Click="Settings_Click"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock x:Name="HotkeyHint" Foreground="#777" FontSize="12"/>
        </Border>

        <!-- 右侧缩略图列表 -->
        <Border DockPanel.Dock="Right" Width="150" BorderBrush="#DDD" BorderThickness="1,0,0,0" Background="#FAFAFA">
            <Grid>
                <TextBlock x:Name="ListHint" Text="截图后出现在这里&#x0a;单击钉到白板"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="#AAA" FontSize="11" Margin="12,24"
                           IsHitTestVisible="False"/>
                <ListBox x:Name="ShotList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         PreviewMouseWheel="ShotList_PreviewMouseWheel"
                         PreviewMouseLeftButtonUp="ShotList_PreviewMouseLeftButtonUp">
                    <ListBox.Resources>
                        <!-- 细滚动条：无箭头、圆角滑块、悬停/拖动加深 -->
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="6"/>
                            <Setter Property="MinWidth" Value="6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/>
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb MinHeight="30">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border x:Name="Bd" Background="#C6CCD4" CornerRadius="4.5" Margin="1,0"/>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#94A0AD"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsDragging" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#75818E"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/>
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6" ToolTip="单击添加到白板">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="删除" Click="ShotListDeleteItem_Click"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <Border BorderBrush="#CCC" BorderThickness="1" Background="White">
                                    <Image Source="{Binding Thumbnail}" Width="120" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                           FontSize="10" Foreground="#888" Margin="2,3,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 白板：外层裁切，内层可平移 -->
        <Grid ClipToBounds="True" Background="White">
            <controls:BoardCanvas x:Name="Board"/>
            <TextBlock x:Name="BoardHint"
                       Text="单击右侧截图钉到白板，可拖拽、滚轮缩放；中键拖动画布"
                       Foreground="#BBBBBB" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="40"
                       IsHitTestVisible="False"/>
        </Grid>
    </DockPanel>
</Window>
